# ════════════════════════════════════════════════════════
#  Семейный бюджет — конфигурация
#  Скопируйте этот файл в .env и заполните значения
# ════════════════════════════════════════════════════════

# ── Режим работы ──────────────────────────────────────
# "web"      — веб-приложение (node src/server.js)
# "telegram" — Telegram-бот (node src/index.js)
APP_MODE=web

# ── Веб-приложение ────────────────────────────────────
PORT=3000

# Секретный ключ для подписи JWT токенов (сгенерируйте случайную строку)
JWT_SECRET=your-very-secret-random-string-here

# Пользователь 1 (муж)
USER1_LOGIN=husband
USER1_PASSWORD=your_strong_password_1
USER1_NAME=Муж

# Пользователь 2 (жена)
USER2_LOGIN=wife
USER2_PASSWORD=your_strong_password_2
USER2_NAME=Жена

# ── Telegram-бот (нужно только при APP_MODE=telegram) ─
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# ALLOWED_USERS=123456789,987654321

# ── AI-парсинг (OpenRouter) ───────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# Цепочка fallback-моделей (через запятую)
# AI_MODELS=google/gemini-flash-1.5,google/gemma-3-27b-it,meta-llama/llama-3.1-8b-instruct

# Таймаут запроса к AI (мс)
# AI_TIMEOUT=15000

# ── Хранилище данных ──────────────────────────────────
DATA_FILE=./data/expenses.json

# ── Бюджет ────────────────────────────────────────────
# Общие плановые расходы за месяц
PLANNED_MONTHLY=194000

# Постоянные обязательные расходы
PLANNED_FIXED=57000

# День списания постоянных расходов
FIXED_EXPENSES_DAY=15

# День начала отслеживания (оставьте пустым для автоопределения)
# TRACKING_START_DAY=1

# Ключевые слова для авто-пометки постоянных расходов
# FIXED_KEYWORDS=ипотека,жкх,коммунальн,садик,допурок,кружок

# ── Напоминания ───────────────────────────────────────
# Включить напоминания
REMINDERS_ENABLED=true

# Час отправки (по Московскому времени, 24h)
REMINDER_HOUR=20
REMINDER_MINUTE=0

{
  "expo": {
    "name": "Семейный бюджет",
    "slug": "family-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.familybudget.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      ["expo-notifications", {
        "icon": "./assets/notification-icon.png",
        "color": "#3b82f6"
      }],
      ["expo-camera", { "cameraPermission": "Разрешите доступ к камере для сканирования чеков." }],
      ["expo-image-picker", { "photosPermission": "Разрешите доступ к фото для загрузки чеков." }]
    ],
    "scheme": "familybudget",
    "extra": {
      "eas": { "projectId": "your-eas-project-id" }
    }
  }
}
